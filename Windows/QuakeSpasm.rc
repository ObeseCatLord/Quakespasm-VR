#include <winresrc.h>

icon ICON "QuakeSpasm.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Quakespasm VR\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "Quakespasm VR\0"
            VALUE "OriginalFilename", "quakespasm-openvr.exe\0"
            VALUE "ProductName", "Quakespasm VR\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
