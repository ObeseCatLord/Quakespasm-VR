#version 450
/* The long Y footprint makes ordinary trilinear filtering select the box mip.
 * One-texel X stripes should survive the supported anisotropic request. */
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 1, binding = 0, std430) buffer Readback { float value[]; } outbuf;
layout(local_size_x = 1) in;
layout(push_constant) uniform Footprint { float anisotropy; } footprint;
void main()
{
	uint x = gl_GlobalInvocationID.x;
	/* A negative footprint selects a magnification witness between texel
	 * centers, distinguishing nearest from linear without anisotropy. */
	bool magnify = footprint.anisotropy < 0.;
	float offset = magnify ? .25 : .5;
	float gradient = magnify ? .25 : 1.;
	outbuf.value[x] = textureGrad(source, vec2((float(x) + offset) / 128., .5),
		vec2(gradient / 128., 0.), vec2(0., abs(footprint.anisotropy) / 128.)).r;
}
