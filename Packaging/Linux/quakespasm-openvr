#!/bin/bash
# Preserve existing launcher names while selecting the packaged 2.0 runtime.
set -e
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
args=()
for arg in "$@"; do
    if [[ "$arg" == "-vr" ]]; then args+=("-openxr"); else args+=("$arg"); fi
done
# The updater writes an ordinary executable here (it cannot create symlinks).
# Native packages and existing installations retain their own binary layout.
if [[ -x "$SCRIPT_DIR/bin/quakespasm-openvr.bin" ]]; then
    ENGINE="$(readlink -f -- "$SCRIPT_DIR/bin/quakespasm-openvr.bin")"
elif [[ -x "$SCRIPT_DIR/bin/vkquake" ]]; then
    ENGINE="$(readlink -f -- "$SCRIPT_DIR/bin/vkquake")"
else
    ENGINE="$(readlink -f -- "$SCRIPT_DIR/quakespasm-openvr.bin")"
fi
ENGINE_DIR="$(dirname -- "$ENGINE")"
# Legacy launchers put SteamVR and the old engine libraries first. Keep the
# matching SDL/Vulkan/Steam Audio package ahead of those inherited paths.
export LD_LIBRARY_PATH="$ENGINE_DIR/../lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# The native cmdline cvar has a bounded length. Do not spend its budget on
# the immutable runtime's long installation path before +map/+connect.
exec -a quakespasm-openvr "$ENGINE" "${args[@]}"
